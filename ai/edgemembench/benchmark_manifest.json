{
  "name": "EdgeMemBench",
  "version": "0.3.0",
  "profile": "edgemem-abcd-v0",
  "description": "Repository-local evaluation set for memory admission, retrieval, update handling, and abstention.",
  "axes": {
    "A": {
      "task": "storage_decision",
      "expected_cases": 300
    },
    "B": {
      "task": "single_memory_retrieval",
      "expected_cases": 92
    },
    "C": {
      "task": "knowledge_update",
      "expected_cases": 72
    },
    "D": {
      "task": "abstention",
      "expected_cases": 30
    }
  },
  "excluded_from_v0": {
    "E": "multi-memory composition",
    "F": "persona-level personalization"
  },
  "evaluation_contract": {
    "admission": {
      "A": "Run the actual memory admission decision.",
      "B-D": "Bypass admission and inject every user turn as an existing memory observation."
    },
    "B": {
      "hit_at_k": "Success when any gold evidence appears in top K.",
      "mrr": "Use the best-ranked gold evidence.",
      "recall_at_k": "Fraction of all gold evidence recovered in top K."
    },
    "C": {
      "subtypes": [
        "current_state",
        "historical_state",
        "multi_state",
        "single_state"
      ],
      "retrieval_metrics": [
        "target_hit_at_k",
        "best_target_mrr",
        "target_recall_at_k",
        "target_before_competing"
      ],
      "scoring_policy": "Use the manually reviewed target/competing/context partition. Excluded source-contract cases remain in artifacts but do not contribute to aggregate scores.",
      "known_baseline_limitation": "The current product memory prompt does not expose timestamps to the reader."
    },
    "D": {
      "subtypes": [
        "partial_evidence",
        "absent_evidence"
      ],
      "retrieval_metrics": [
        "query_level_auroc",
        "threshold_sweep"
      ],
      "reader_metrics": [
        "abstention_accuracy",
        "false_answer_rate"
      ],
      "threshold_policy": "Do not select or tune an operating threshold on the v0 test set."
    }
  },
  "artifacts": {
    "storage_decision.jsonl": {
      "axis": "A",
      "expected_cases": 300,
      "sha256": "4f344e1aaea92148f0f87a5841e97615de91c4cba8f15cc851316cf7e50cf7fd"
