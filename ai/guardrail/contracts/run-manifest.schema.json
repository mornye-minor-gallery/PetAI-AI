{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petai.local/guardrail/run-manifest.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "benchmark_id",
    "benchmark_version",
    "run_id",
    "profile",
    "status",
    "git",
    "target",
    "prompt",
    "sources",
    "started_at",
    "ended_at",
    "outputs"
  ],
  "properties": {
    "benchmark_id": {"const": "petai-guardrail-baseline"},
    "benchmark_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "profile": {"enum": ["smoke", "baseline"]},
    "status": {"enum": ["completed", "failed", "cancelled"]},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "git": {"type": "object"},
    "target": {"type": "object"},
    "prompt": {"type": "object"},
    "sources": {"type": "object"},
    "outputs": {"type": "object"}
  }
}
