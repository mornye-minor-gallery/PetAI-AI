{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petai.local/facetroutebench/run-manifest.schema.json",
  "title": "FacetRouteBench run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "benchmark_version",
    "run_id",
    "status",
    "git_commit",
    "started_at",
    "ended_at",
    "track",
    "candidate",
    "dataset",
    "contracts",
    "models",
    "runtime",
    "hardware",
    "result"
  ],
  "properties": {
    "benchmark_id": {"const": "facetroutebench"},
    "benchmark_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "failed", "cancelled"]},
    "git_commit": {"type": "string", "pattern": "^[a-f0-9]{7,40}$"},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "track": {"enum": ["controlled_single_turn", "product_condition", "context_challenge", "router_latency"]},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "router_family", "config_path", "config_sha256"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "router_family": {"enum": ["gemma_generative", "embedding_similarity"]},
        "config_path": {"type": "string", "minLength": 1},
        "config_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "record_count", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "record_count": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fileEvidence"}
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "model_id", "artifact_sha256", "checkpoint_lineage", "quantization"],
        "properties": {
          "role": {"enum": ["router", "embedder"]},
          "model_id": {"type": "string", "minLength": 1},
          "artifact_sha256": {"$ref": "#/$defs/sha256"},
          "checkpoint_lineage": {"type": "string", "minLength": 1},
          "quantization": {"type": "string", "minLength": 1}
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "backend"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "backend": {"enum": ["cpu", "gpu", "npu", "mixed", "unknown"]}
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "device_model", "os_version"],
      "properties": {
        "platform": {"enum": ["macos", "ios"]},
        "device_model": {"type": "string", "minLength": 1},
        "os_version": {"type": "string", "minLength": 1},
        "memory_bytes": {"type": "integer", "minimum": 1},
        "battery_percent_start": {"type": "number", "minimum": 0, "maximum": 100},
        "battery_percent_end": {"type": "number", "minimum": 0, "maximum": 100},
        "thermal_state_start": {"type": "string"},
        "thermal_state_end": {"type": "string"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "notes": {"type": "string"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
