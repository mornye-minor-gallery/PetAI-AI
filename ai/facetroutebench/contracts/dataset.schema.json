{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petai.local/facetroutebench/dataset.schema.json",
  "title": "FacetRouteBench dataset record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "dataset_version",
    "split",
    "track",
    "gold_route_id",
    "facet_id",
    "difficulty",
    "domain",
    "messages",
    "style_tags",
    "provenance"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^frb-[a-z0-9][a-z0-9-]*$"
    },
    "dataset_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "split": {
      "enum": ["authoring", "dev", "frozen", "context_challenge"]
    },
    "track": {
      "enum": ["single_turn", "context_challenge"]
    },
    "gold_route_id": {
      "$ref": "#/$defs/routeId"
    },
    "facet_id": {
      "oneOf": [
        {"$ref": "#/$defs/facetId"},
        {"type": "null"}
      ]
    },
    "difficulty": {
      "enum": ["direct", "natural", "neighbor", "general", "hard_negative", "context_dependent"]
    },
    "domain": {
      "enum": ["narrative", "pet_daily", "mixed"]
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "style_tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "short_chat",
          "daily_natural",
          "emotional",
          "narrative",
          "formal",
          "informal",
          "elliptical",
          "indirect",
          "minor_typo"
        ]
      }
    },
    "neighbor_route_id": {
      "$ref": "#/$defs/routeId"
    },
    "generation_batch_id": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"split": {"const": "authoring"}},
        "required": ["split"]
      },
      "then": {
        "properties": {
          "track": {"const": "single_turn"},
          "gold_route_id": {"not": {"const": "GENERAL"}},
          "difficulty": {"enum": ["direct", "natural", "neighbor"]}
        }
      }
    },
    {
      "if": {
        "properties": {"split": {"enum": ["dev", "frozen"]}},
        "required": ["split"]
      },
      "then": {
        "properties": {
          "track": {"const": "single_turn"}
        }
      }
    },
    {
      "if": {
        "properties": {"track": {"const": "single_turn"}},
        "required": ["track"]
      },
      "then": {
        "properties": {
          "messages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "allOf": [
                {"$ref": "#/$defs/message"},
                {"properties": {"role": {"const": "user"}}}
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"split": {"const": "context_challenge"}},
        "required": ["split"]
      },
      "then": {
        "properties": {
          "track": {"const": "context_challenge"},
          "difficulty": {"const": "context_dependent"},
          "messages": {"minItems": 3}
        }
      }
    },
    {
      "if": {
        "properties": {"gold_route_id": {"const": "GENERAL"}},
        "required": ["gold_route_id"]
      },
      "then": {
        "properties": {
          "facet_id": {"type": "null"},
          "difficulty": {"enum": ["general", "hard_negative", "context_dependent"]}
        }
      },
      "else": {
        "properties": {
          "facet_id": {"$ref": "#/$defs/facetId"}
        }
      }
    },
    {
      "if": {
        "properties": {"difficulty": {"const": "neighbor"}},
        "required": ["difficulty"]
      },
      "then": {
        "required": ["neighbor_route_id"]
      }
    },
    {
      "if": {
        "properties": {"difficulty": {"enum": ["direct", "natural", "neighbor"]}},
        "required": ["difficulty"]
      },
      "then": {
        "properties": {
          "gold_route_id": {"not": {"const": "GENERAL"}}
        }
      }
    },
    {
      "if": {
        "properties": {"difficulty": {"enum": ["general", "hard_negative"]}},
        "required": ["difficulty"]
      },
      "then": {
        "properties": {
          "split": {"enum": ["dev", "frozen"]},
          "gold_route_id": {"const": "GENERAL"},
          "facet_id": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "routeId": {
      "enum": [
        "FIRST_SIGNAL",
        "FIRST_ARRIVAL",
        "FIRST_HOME",
        "EARTH_TERM",
        "EARTH_FOOD",
        "EARTH_RELATION",
        "AMBIG_CAUSE",
        "AMBIG_CHOICE",
        "RETURN_SIGNAL",
        "RETURN_SMILE",
        "RETURN_FUTURE",
        "RETURN_FEAR",
        "SUPPORT_SELF_BLAME",
        "SUPPORT_LISTEN",
        "SUPPORT_COMPANY",
        "SUPPORT_REST",
        "PLAYFUL_SMILE",
        "PLAYFUL_CLAIM",
        "PLAYFUL_COMPASS",
        "GENERAL"
      ]
    },
    "facetId": {
      "enum": [
        "first_contact",
        "earth_culture_unknown",
        "ambiguous_direction",
        "return_or_twin",
        "user_needs_support",
        "playful_exchange"
      ]
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": {"enum": ["user", "assistant"]},
        "content": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "blind_validator", "validation_result"],
      "properties": {
        "generator": {"$ref": "#/$defs/modelInvocation"},
        "blind_validator": {"$ref": "#/$defs/modelInvocation"},
        "validation_result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["predicted_route_id", "accepted"],
          "properties": {
            "predicted_route_id": {
              "oneOf": [
                {"$ref": "#/$defs/routeId"},
                {"const": "AMBIGUOUS"}
              ]
            },
            "accepted": {"const": true}
          }
        }
      }
    },
    "modelInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface", "model", "reasoning_effort", "prompt_sha256", "session_id"],
      "properties": {
        "interface": {"const": "codex_cli"},
        "model": {"const": "gpt-5.6-sol"},
        "reasoning_effort": {"const": "medium"},
        "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "session_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
