{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "accepted", "reason_code"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "accepted": {"type": "boolean"},
          "reason_code": {
            "enum": [
              "NONE",
              "IDENTITY_CONFLICT",
              "RELATIONSHIP_CONFLICT",
              "SETTING_CONFLICT",
              "KNOWLEDGE_BOUNDARY_CONFLICT",
              "UNNATURAL_DIALOGUE"
            ]
          }
        }
      }
    }
  }
}
