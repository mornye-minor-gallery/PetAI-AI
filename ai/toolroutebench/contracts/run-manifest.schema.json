{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petai.local/toolroutebench/run-manifest.schema.json",
  "title": "ToolRouteBench run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "benchmark_version",
    "run_id",
    "status",
    "git_commit",
    "started_at",
    "ended_at",
    "track",
    "candidate",
    "dataset",
    "contracts",
    "models",
    "runtime",
    "hardware",
    "result"
  ],
  "properties": {
    "benchmark_id": {"const": "toolroutebench"},
    "benchmark_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "failed", "cancelled"]},
    "git_commit": {"type": "string", "pattern": "^[a-f0-9]{7,40}$"},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "track": {"enum": ["dev", "holdout", "multilabel_challenge", "router_latency"]},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "router_family", "config_sha256"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "router_family": {
          "enum": [
            "swift_regex",
            "embedding_similarity_multilabel",
            "gemma_prompt_classifier"
          ]
        },
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dataset": {"$ref": "#/$defs/fileEvidence"},
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fileEvidence"}
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "model_id", "artifact_sha256"],
        "properties": {
          "role": {"enum": ["embedder", "tokenizer", "router"]},
          "model_id": {"type": "string", "minLength": 1},
          "artifact_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "backend"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "backend": {"enum": ["cpu", "gpu", "npu", "mixed", "unknown"]}
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "device_model", "os_version"],
      "properties": {
        "platform": {"enum": ["macos", "ios"]},
        "device_model": {"type": "string", "minLength": 1},
        "os_version": {"type": "string", "minLength": 1}
      }
    },
    "result": {"$ref": "#/$defs/fileEvidence"},
    "holdout_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_locked", "dataset_sha256_locked", "reused_after_tuning"],
      "properties": {
        "candidate_locked": {"type": "boolean"},
        "dataset_sha256_locked": {"type": "boolean"},
        "reused_after_tuning": {"const": false}
      }
    },
    "notes": {"type": "string"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
