{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "pair_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "kind": {
      "enum": [
        "wrong_name",
        "correct_name"
      ]
    },
    "character_name": {
      "type": "string",
      "minLength": 1
    },
    "called_name": {
      "type": "string",
      "minLength": 1
    },
    "user_message": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "pair_id",
    "kind",
    "character_name",
    "called_name",
    "user_message"
  ]
}
