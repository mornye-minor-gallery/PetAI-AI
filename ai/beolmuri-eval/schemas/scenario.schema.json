{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "character_name",
    "turns"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "pair_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "character_name": {
      "type": "string",
      "minLength": 1
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "user_message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "user_message": {
            "type": "string",
            "minLength": 1
          },
          "called_name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "dialogue",
              "wrong_name",
              "correct_name"
            ]
          },
          "world_info_context": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "characterTags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "trigger": {
                "type": "string"
              },
              "scanFields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "externallyActivated": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "vectorMatches": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "example_dialogue": {
            "type": "string"
          },
          "memories": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
