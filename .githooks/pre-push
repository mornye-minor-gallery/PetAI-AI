#!/bin/sh
# Managed by repository privacy hook installer
set -eu

remote_name=$1
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
checker="$hook_dir/repository-privacy/check_repository_privacy.py"

if [ ! -f "$checker" ]; then
    echo "Privacy check unavailable: reinstall the pre-push hook." >&2
    exit 1
fi

while read -r local_ref local_oid remote_ref remote_oid; do
    if [ "$local_ref" = "(delete)" ]; then
        continue
    fi

    case "$remote_oid" in
        *[!0]*) base=$remote_oid ;;
        *)
            if ! base=$(git merge-base "$local_oid" "refs/remotes/$remote_name/main"); then
                echo "Privacy check cannot find the remote main baseline; fetch it before pushing." >&2
                exit 1
            fi
            ;;
    esac

    python3 "$checker" --base "$base" --head "$local_oid" || exit 1
done
