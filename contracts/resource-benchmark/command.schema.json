{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resource benchmark command",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "owner_id": {
      "type": "string",
      "format": "uuid"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "operation": {
      "enum": [
        "prepare",
        "begin",
        "cancel",
        "snapshot"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "manifest_sha256"
      ]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "operation_id",
    "owner_id",
    "expected_revision",
    "operation",
    "payload"
  ]
}
