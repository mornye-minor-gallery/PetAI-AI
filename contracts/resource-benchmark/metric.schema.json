{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resource benchmark metric",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "ok",
        "unsupported",
        "missing",
        "invalid",
        "not_requested"
      ]
    },
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "interval": {
      "type": "object"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "status",
    "value",
    "unit",
    "source",
    "interval",
    "reason"
  ]
}
