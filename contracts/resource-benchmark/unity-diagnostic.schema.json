{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unity RAM diagnostic plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "character_id", "player_name", "thinking_enabled", "ram_sample_period_ms", "reply_gap_ms", "timeout_ms", "inputs"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "run_id": {"type": "string", "format": "uuid"},
    "character_id": {"type": "string", "minLength": 1},
    "player_name": {"type": "string", "minLength": 1},
    "thinking_enabled": {"type": "boolean"},
    "ram_sample_period_ms": {"type": "integer", "minimum": 10, "maximum": 10000},
    "reply_gap_ms": {"type": "integer", "minimum": 0, "maximum": 60000},
    "timeout_ms": {"type": "integer", "minimum": 1000, "maximum": 3600000},
    "inputs": {"type": "array", "minItems": 1, "maxItems": 100, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "prompt"],
      "properties": {"id": {"type": "string", "minLength": 1}, "prompt": {"type": "string", "minLength": 1}}
    }}
  }
}
