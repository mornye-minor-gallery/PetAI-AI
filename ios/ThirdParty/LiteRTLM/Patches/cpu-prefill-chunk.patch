+#ifndef LITERT_LM_CPU_PREFILL_CHUNK_H_
+#define LITERT_LM_CPU_PREFILL_CHUNK_H_
+
+namespace litert::lm {
+
+// Kept independent of executor/model headers so the selection policy can be
+// tested without loading a model. A missing graph is an error, not permission
+// to select a larger graph with a larger temporary arena.
+template <typename RunnerMap>
+bool LimitCpuPrefillRunners(RunnerMap& runners, int chunk_size) {
+  if (chunk_size > 0) {
+    for (auto it = runners.begin(); it != runners.end();) {
+      if (it->first > chunk_size) it = runners.erase(it);
+      else ++it;
+    }
+  }
+  return !runners.empty();
+}
+
+}  // namespace litert::lm
+#endif  // LITERT_LM_CPU_PREFILL_CHUNK_H_
