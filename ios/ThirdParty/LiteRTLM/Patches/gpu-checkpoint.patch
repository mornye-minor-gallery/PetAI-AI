@@ -0,0 +1,35 @@
+#pragma once
+#include <algorithm>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace litert::lm::checkpoint {
+// Deliberately independent of execution's GetStateBuffers: that API rotates
+// ping-pong banks and omits inputs in GPU-optimized inplace mode.
+template <class Bank, class OptionalBank>
+auto BankPointers(Bank& first, OptionalBank& second) {
+  using Buffer = decltype(first.begin()->second.buffer);
+  std::vector<std::pair<std::string, Buffer*>> result;
+  for (auto& [name, slot] : first)
+    result.emplace_back("bank1/" + name, &slot.buffer);
+  if (second) for (auto& [name, slot] : *second)
+    result.emplace_back("bank2/" + name, &slot.buffer);
+  std::sort(result.begin(), result.end(), [](auto& a, auto& b) {
+    return a.first < b.first;
+  });
+  return result;
+}
+
+enum class TransferResult { kOk, kLockFailed, kTransferFailed, kUnlockFailed };
+
+// Unlock can perform the actual CPU -> GPU upload. Its error must outrank an
+// I/O error: the caller must discard the engine when upload/unlock fails.
+template <class Lock, class Transfer, class Unlock>
+TransferResult TransferMapped(Lock lock, Transfer transfer, Unlock unlock) {
+  if (!lock()) return TransferResult::kLockFailed;
+  bool transferred = transfer();
+  if (!unlock()) return TransferResult::kUnlockFailed;
+  return transferred ? TransferResult::kOk : TransferResult::kTransferFailed;
+}
+}  // namespace litert::lm::checkpoint
